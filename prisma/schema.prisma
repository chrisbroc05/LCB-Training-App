generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum MembershipTier {
  FREE
  BASIC
  TWELVE_WEEK
  MEMORABLE
  ELITE
}

enum MembershipLevel {
  CORE
  PLUS
  ALL_ACCESS
}

enum OrgBillingMode {
  FAMILY_PAY
  CLUB_PAY
}

enum CoachingReviewTrack {
  FREE_ONCE
  PLAYBOOK
  QUICK_SIX_WEEK
  ORG_TRIAL_QUICK
  IN_DEPTH_MONTHLY
  PROGRAM
}

enum FreeSwingAnalysisResponseMode {
  VIDEO
  WRITTEN_REPORT
}

enum ProgramPlanMode {
  FIXED_12_WEEK
  OPEN_ENDED
}

enum SubscriptionStatus {
  NONE
  ACTIVE
  CANCEL_AT_PERIOD_END
  CANCELED
  PAST_DUE
  EXPIRED
}

enum MentalGameTopic {
  SLUMP
  CONFIDENCE
  NERVES
  FEAR_OF_FAILURE
  PRESSURE_SITUATIONS
  LOSING_MOTIVATION
  OTHER
}

enum MentalGameResponsePreference {
  VIDEO_RESPONSE
  WRITTEN_RESPONSE
}

enum MentalGameSubmissionStatus {
  PENDING
  REVIEWING
  COMPLETED
}

enum ProgramEnrollmentStatus {
  ACTIVE
  PAUSED
  COMPLETED
  REFUNDED
}

enum DayLogType {
  GAME
  PRACTICE
}

enum ProgramAgeGroup {
  AGE_8_11
  AGE_12_15
  AGE_16_18
}

enum ProgramSeasonMode {
  IN_SEASON
  OFF_SEASON
}

enum ProgramEmailRecipient {
  player
  parent
  coach
}

enum ProgramEmailType {
  DAILY_ROUTINE
  DAY_BEFORE_START
  SATURDAY_VIDEO_REMINDER
  GONE_QUIET
  PARENT_SATURDAY_VIDEO
  PARENT_GONE_QUIET
  PARENT_WEEKLY_RECAP
  COACH_DAILY_SUMMARY
  COACH_MESSAGE_REPLY
  COACH_VIDEO
  COACH_TASK_FEEDBACK
  SETUP_REMINDER
}

enum PushNotificationType {
  DAILY_WORK
  DAY_BEFORE_START
  SATURDAY_VIDEO
  GONE_QUIET
  COACH_RESPONSE
  PLAN_UPDATE
  COACH_NEW_SUBMISSION
  COACH_NEW_PROGRAM_PLAYER
  COACH_NIGHTLY_SUMMARY
  COACH_NEW_MESSAGE
  COACH_REPLY
  COACH_REFUND_PROCESSED
  COACH_WAIVER_SIGNED
  COACH_VIDEO
  SETUP_REMINDER
  COACH_TASK_FEEDBACK
  TEST
}

enum CoachVideoDrillCategory {
  HITTING
  FIELDING
  MINDSET
  OTHER
}

enum WaiverSignupType {
  PRIVATE_LESSONS
  GROUP_LESSONS
  TEAM_TRAINING
  OTHER
}

enum TestBetterIs {
  LOWER
  HIGHER
}

enum MarketingEmailType {
  WELCOME
  MEMBERSHIP_LEVEL_WELCOME
  TWELVE_WEEK_PROGRAM_WELCOME
  FREE_SUBMISSION_REMINDER
  FOLLOWUP_DRILLS_DAY_2
  FOLLOWUP_OTHER_SIX_DAY_4
  FOLLOWUP_SAMPLE_DAY_DAY_7
  FOLLOWUP_KNOWN_FOR_DAY_10
}

enum AccountRole {
  PLAYER
  PARENT
}

model User {
  id                     String                 @id @default(cuid())
  name                   String?
  accountRole            AccountRole            @default(PLAYER)
  accountHolderName      String?
  playerFirstName        String?
  playerLastName         String?
  email                  String                 @unique
  password               String
  signupDate             DateTime               @default(now())
  onboardingEmail1Sent   Boolean                @default(false)
  onboardingEmail2Sent   Boolean                @default(false)
  onboardingEmail3Sent   Boolean                @default(false)
  freeSubmissionUsed     Boolean                @default(false)
  playbookSubmissionsUsed Int                   @default(0)
  coachingSubmissionsUsedThisMonth Int          @default(0)
  coachingSubmissionPeriod         String?
  eliteRolloverCredits             Int          @default(0)
  assessmentCallBooked             Boolean      @default(false)
  assessmentCallDate               DateTime?
  twelveWeekCallBooked             Boolean      @default(false)
  twelveWeekCallScheduledAt        DateTime?
  membershipTier         MembershipTier         @default(FREE)
  membershipLevel        MembershipLevel?
  membershipLevelExpiresAt DateTime?
  playbookLegacyAccess   Boolean                @default(false)
  membershipTierBeforeProgram MembershipTier?
  marketingEmailsSuppressed Boolean             @default(false)
  isTestAccount             Boolean             @default(false)
  twelveWeekProgramStartedAt DateTime?
  twelveWeekProgramEndsAt    DateTime?
  pendingCheckoutTier    MembershipTier?
  pendingCheckoutLevel   MembershipLevel?
  subscriptionStatus     SubscriptionStatus     @default(ACTIVE)
  stripeCustomerId       String?                @unique
  stripeSubscriptionId   String?                @unique
  stripePriceId          String?
  subscriptionCurrentPeriodEnd DateTime?
  subscriptionCancelAtPeriodEnd Boolean         @default(false)
  position               String?
  age                    Int?
  graduationYear         Int?
  currentTeam            String?
  level                  String?
  playerBio              String?
  adminNotes             String?
  notifySubmissionResponse Boolean              @default(true)
  notifyGoalResponse       Boolean              @default(true)
  notifyWeeklyCheckin      Boolean              @default(true)
  notifyAnnouncements      Boolean              @default(true)
  termsVersion           String?
  termsAcceptedAt        DateTime?
  acceptedByName         String?
  acceptedAsParent       Boolean                @default(false)
  playerAge              Int?
  parentConsentName      String?
  parentConsentEmail     String?
  parentConsentConfirmedAt DateTime?
  parentConsentEmailSentAt DateTime?
  parentConsentReminderSentAt DateTime?
  parentConsentManualResendDayKey String?
  parentConsentManualResendCount Int @default(0)
  mediaConsent           Boolean                @default(false)
  mediaConsentUpdatedAt  DateTime?
  trainsInPerson         Boolean                @default(false)
  emergencyContactName   String?
  emergencyContactPhone  String?
  medicalNotes           String?
  inPersonInfoUpdatedAt  DateTime?
  emailVerified          DateTime?
  image                  String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  accounts               Account[]
  sessions               Session[]
  mentalGameSubmissions  MentalGameSubmission[]
  swingAnalysisSubmissions SwingAnalysisSubmission[]
  goalCheckins           GoalCheckin[]
  playbookProgress       PlaybookProgress?
  notifications          Notification[]
  programEnrollment      ProgramEnrollment?
  directConversation     Conversation?          @relation("UserDirectConversation")
  pushSubscriptions      PushSubscription[]
  pushLogs               PushLog[]
  marketingEmailLogs     MarketingEmailLog[]
  coachAlertSettings     CoachAlertSettings?
  sentMessages           Message[]              @relation("MessageSender")
  waiverSignatures       WaiverSignature[]
  coachVideos            CoachVideo[]
  testPlayers            TestPlayer[]
  linkedLeads            Lead[]
  quizAttempts           QuizAttempt[]
  resourcePurchases      ResourcePurchase[]
  remoteSessionPurchases RemoteSessionPurchase[]
  organizationId         String?
  orgTeamId              String?
  orgJoinedAt            DateTime?
  orgTeamChangedAt       DateTime?
  orgTrialQuickReportUsed Boolean               @default(false)
  orgTrialDashboardDismissedAt DateTime?
  coreQuickReportNextEligibleAt DateTime?
  organization           Organization?          @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  orgTeam                OrgTeam?               @relation(fields: [orgTeamId], references: [id], onDelete: SetNull)
  fixItGrants            UserFixItGrant[]
  membershipSubscription MembershipSubscription?

  @@index([organizationId])
  @@index([orgTeamId])
}

model UserFixItGrant {
  id                  String   @id @default(cuid())
  userId              String
  resourceSlug        String
  createdAt           DateTime @default(now())
  createdByAdminEmail String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, resourceSlug])
  @@index([userId])
}

model Organization {
  id                 String          @id @default(cuid())
  name               String
  slug               String          @unique
  logoUrl            String?
  active             Boolean         @default(true)
  billingMode        OrgBillingMode  @default(FAMILY_PAY)
  coveredLevel       MembershipLevel?
  trialStartsAt      DateTime?
  trialEndsAt        DateTime?
  trialLockedCopy    String?
  commissionRate     Float           @default(0)
  commissionMonths   Int             @default(0)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  codes              OrgCode[]
  teams              OrgTeam[]
  weeklyFocuses      OrgWeeklyFocus[]
  members            User[]
  membershipSubscriptions MembershipSubscription[]
}

model OrgCode {
  id             String       @id @default(cuid())
  organizationId String
  code           String       @unique
  label          String?
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model OrgTeam {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  sortOrder      Int          @default(0)
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        User[]
  weeklyFocuses  OrgWeeklyFocus[]

  @@index([organizationId])
}

model OrgWeeklyFocus {
  id             String       @id @default(cuid())
  organizationId String
  orgTeamId      String?
  weekStartDate  DateTime
  title          String
  notes          String?
  drillIds       String[]     @default([])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orgTeam        OrgTeam?     @relation(fields: [orgTeamId], references: [id], onDelete: Cascade)

  @@index([organizationId, weekStartDate])
  @@index([orgTeamId, weekStartDate])
}

enum LeadRole {
  PLAYER
  PARENT
  COACH
}

model Lead {
  id                String         @id @default(cuid())
  email             String         @unique
  firstName         String
  role              LeadRole
  source            String
  firstResourceSlug String?
  isBuyer           Boolean        @default(false)
  userId            String?
  user              User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  unsubscribedAt            DateTime?
  emailProvidedByParent     Boolean      @default(false)
  marketingExcludedAt       DateTime?
  marketingExcludedReason   String?
  createdAt                 DateTime       @default(now())
  resources         LeadResource[]
  emailLogs         LeadEmailLog[]
  quizAttempts      QuizAttempt[]

  @@index([source])
  @@index([role])
  @@index([createdAt(sort: Desc)])
}

model LeadResource {
  id                String    @id @default(cuid())
  leadId            String
  lead              Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  resourceSlug      String
  checkoutStartedAt DateTime?
  createdAt         DateTime  @default(now())

  @@index([leadId])
  @@index([resourceSlug])
}

model QuizAttempt {
  id             String    @id @default(cuid())
  leadId         String?
  lead           Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  userId         String?
  user           User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  role           LeadRole
  answers        Json      @default("{}")
  optionOrder    Json
  score          Int?
  categoryScores Json?
  level          String?
  createdAt      DateTime  @default(now())
  completedAt    DateTime?

  @@index([completedAt(sort: Desc)])
  @@index([leadId])
  @@index([userId])
}

model LeadEmailLog {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      String
  dedupeKey String   @unique
  sentAt    DateTime @default(now())

  @@index([leadId, type])
}

model ResourcePurchase {
  id              String   @id @default(cuid())
  email           String
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  resourceSlug    String
  stripeSessionId String   @unique
  amountCents     Int?
  refundedAt      DateTime?
  createdAt       DateTime @default(now())

  @@index([email])
  @@index([userId])
  @@index([resourceSlug])
}

model RemoteSessionPurchase {
  id              String   @id @default(cuid())
  email           String
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  stripeSessionId String   @unique
  amountCents     Int?
  createdAt       DateTime @default(now())

  @@index([email])
  @@index([userId])
}

model WaiverSignature {
  id                    String           @id @default(cuid())
  playerFirstName       String
  playerLastName        String
  playerAge             Int
  teamName              String?
  teamSlug              String?
  signupType            WaiverSignupType
  signerFullName        String
  signerEmail           String
  signerPhone           String?
  emergencyContactName  String
  emergencyContactPhone String
  medicalNotes          String?
  mediaConsent          Boolean          @default(false)
  typedSignature        String
  version               String
  signedAt              DateTime         @default(now())
  submissionBatchId     String?
  ip                    String
  userId                String?
  user                  User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  testPlayers           TestPlayer[]

  @@index([signedAt(sort: Desc)])
  @@index([teamSlug])
  @@index([signerEmail])
  @@index([userId])
  @@index([ip, signedAt])
  @@index([submissionBatchId])
}

model MarketingEmailLog {
  id                 String             @id @default(cuid())
  userId             String
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  type               MarketingEmailType
  dedupeKey          String             @unique
  anchorSubmissionId String?
  sentAt             DateTime           @default(now())

  @@index([userId, type])
}

model ProgramEnrollment {
  id                    String                  @id @default(cuid())
  userId                String                  @unique
  user                  User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  status                ProgramEnrollmentStatus @default(ACTIVE)
  planMode              ProgramPlanMode         @default(FIXED_12_WEEK)
  refundedAt            DateTime?
  refundAmountCents     Int?
  stripeRefundChargeId  String?                 @unique
  startDate             DateTime?               @db.Date
  ageGroup              ProgramAgeGroup?
  position              String?
  focusAreas            String[]                @default([])
  equipment             String[]                @default([])
  strengthVariant       String?
  seasonMode            ProgramSeasonMode?
  knownFor                   String?
  onboardingCompletedAt      DateTime?
  dailyRoutineEmailsEnabled  Boolean                 @default(true)
  parentName                 String?
  parentEmail                String?
  parentEmailsEnabled        Boolean                 @default(true)
  parentPromptDismissedAt    DateTime?
  lastTaskFeedbackNotifyAt   DateTime?
  taskFeedbackNotifyPending  Boolean                 @default(false)
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt
  taskCompletions            TaskCompletion[]
  weekFocusOverrides         WeekFocusOverride[]
  customTasks                CustomTask[]
  dayLogs                    DayLog[]
  emailLogs                  EmailLog[]
  conversation               Conversation?
  coachVideos                CoachVideo[]
  coachNotes                 CoachNote[]
  taskFeedbacks              TaskFeedback[]
  enrollmentTracks           EnrollmentTrack[]
}

model CoachVideo {
  id               String                   @id @default(cuid())
  userId           String
  user             User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollmentId     String?
  enrollment       ProgramEnrollment?       @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  title            String
  note             String?
  videoKey         String
  posterR2Key      String?
  videoContentType String
  videoSizeBytes   Int
  drillCategory    CoachVideoDrillCategory?
  notifyPending    Boolean                  @default(false)
  createdAt        DateTime                 @default(now())
  viewedAt         DateTime?

  @@index([userId, createdAt(sort: Desc)])
  @@index([enrollmentId])
  @@index([notifyPending])
}

model EmailLog {
  id           String                @id @default(cuid())
  enrollmentId String?
  enrollment   ProgramEnrollment?    @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  recipient    ProgramEmailRecipient
  type         ProgramEmailType
  dateKey      String
  dedupeKey    String                @unique
  sentAt       DateTime              @default(now())

  @@unique([enrollmentId, recipient, type, dateKey])
  @@index([type, dateKey])
}

model PushSubscription {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint      String
  p256dh        String
  auth          String
  userAgent     String?
  createdAt     DateTime  @default(now())
  lastSuccessAt DateTime?
  failureCount  Int       @default(0)

  @@unique([userId, endpoint])
  @@index([userId])
  @@index([endpoint])
}

model AppAdminSettings {
  id                            Int                           @id @default(1)
  freeSwingAnalysisResponseMode FreeSwingAnalysisResponseMode @default(VIDEO)
}

model CoachAlertSettings {
  userId                     String   @id
  user                       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  newVideosEnabled           Boolean  @default(true)
  newProgramPlayersEnabled     Boolean  @default(true)
  newMessagesEnabled         Boolean  @default(true)
  nightlySummaryPushEnabled    Boolean  @default(true)
  emailNightlySummaryEnabled   Boolean  @default(true)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}

model Conversation {
  id                         String             @id @default(cuid())
  userId                     String?            @unique
  user                       User?              @relation("UserDirectConversation", fields: [userId], references: [id], onDelete: Cascade)
  enrollmentId               String?            @unique
  enrollment                 ProgramEnrollment? @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  createdAt                  DateTime          @default(now())
  lastMessageAt              DateTime          @default(now())
  coachUnreadCount           Int               @default(0)
  playerUnreadCount          Int               @default(0)
  playerReplyNotifyPending   Boolean           @default(false)
  playerReplyNotifyMessageId String?
  messages                   Message[]

  @@index([lastMessageAt])
  @@index([coachUnreadCount])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUserId   String
  sender         User         @relation("MessageSender", fields: [senderUserId], references: [id], onDelete: Cascade)
  fromCoach      Boolean
  body           String       @db.VarChar(1000)
  createdAt      DateTime     @default(now())
  readAt         DateTime?

  @@index([conversationId, createdAt])
  @@index([senderUserId, createdAt])
}

model PushLog {
  id        String               @id @default(cuid())
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      PushNotificationType
  dedupeKey String               @unique
  sentAt    DateTime             @default(now())
  success   Boolean
  error     String?

  @@index([userId, type])
}

model CoachCue {
  id                 String              @id @default(cuid())
  label              String
  drillIds           String[]            @default([])
  isDefault          Boolean             @default(false)
  defaultWeek        Int?
  archived           Boolean             @default(false)
  createdAt          DateTime            @default(now())
  weekFocusOverrides WeekFocusOverride[]
}

model WeekFocusOverride {
  id           String            @id @default(cuid())
  enrollmentId String
  enrollment   ProgramEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  weekNumber   Int
  cueId        String
  cue          CoachCue          @relation(fields: [cueId], references: [id], onDelete: Restrict)
  note         String            @db.VarChar(300)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([enrollmentId, weekNumber])
  @@index([enrollmentId])
}

model CustomTask {
  id              String            @id @default(cuid())
  enrollmentId    String
  enrollment      ProgramEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  programDay      Int
  title           String
  target          String
  details         String?
  drillIds        String[]          @default([])
  replacesTaskKey String?
  createdAt       DateTime          @default(now())

  @@index([enrollmentId, programDay])
}

model EnrollmentTrack {
  id           String            @id @default(cuid())
  enrollmentId String
  enrollment   ProgramEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  trackKey     String
  active       Boolean           @default(true)
  startedAt    DateTime          @default(now())
  note         String?           @db.VarChar(500)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([enrollmentId, trackKey])
  @@index([enrollmentId])
}

model DayLog {
  id              String            @id @default(cuid())
  enrollmentId    String
  enrollment      ProgramEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  programDay      Int
  type            DayLogType
  note            String            @db.VarChar(500)
  createdAt       DateTime          @default(now())
  gameStats       GameStats?
  taskCompletions TaskCompletion[]

  @@index([enrollmentId, programDay])
}

model GameStats {
  id          String  @id @default(cuid())
  dayLogId    String  @unique
  dayLog      DayLog  @relation(fields: [dayLogId], references: [id], onDelete: Cascade)
  opponent    String? @db.VarChar(60)
  atBats      Int     @default(0)
  hits        Int     @default(0)
  doubles     Int     @default(0)
  triples     Int     @default(0)
  homeRuns    Int     @default(0)
  walks       Int     @default(0)
  hitByPitch  Int     @default(0)
  runs        Int     @default(0)
  rbis        Int     @default(0)
  strikeouts  Int     @default(0)
  stolenBases Int     @default(0)
  errors      Int     @default(0)
}

model TaskCompletion {
  id             String            @id @default(cuid())
  enrollmentId   String
  enrollment     ProgramEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  programDay     Int
  taskKey        String
  taskType       String
  completionType String            @default("STANDARD")
  note           String
  completedAt    DateTime          @default(now())
  sourceDayLogId String?
  sourceDayLog   DayLog?           @relation(fields: [sourceDayLogId], references: [id], onDelete: SetNull)
  taskFeedback   TaskFeedback?

  @@unique([enrollmentId, programDay, taskKey])
  @@index([enrollmentId, programDay])
  @@index([sourceDayLogId])
}

model CoachNote {
  id           String            @id @default(cuid())
  enrollmentId String
  enrollment   ProgramEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  body         String            @db.VarChar(2000)
  pinned       Boolean           @default(false)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([enrollmentId, pinned, updatedAt(sort: Desc)])
}

model TaskFeedback {
  id               String            @id @default(cuid())
  enrollmentId     String
  enrollment       ProgramEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  programDay       Int
  taskKey          String
  taskCompletionId String?           @unique
  taskCompletion   TaskCompletion?   @relation(fields: [taskCompletionId], references: [id], onDelete: SetNull)
  liked            Boolean           @default(false)
  comment          String?           @db.VarChar(500)
  seenAt           DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([enrollmentId, programDay, taskKey])
  @@index([enrollmentId, seenAt])
  @@index([enrollmentId, programDay])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String?
  type      String
  read      Boolean  @default(false)
  linkUrl   String?
  createdAt DateTime @default(now())

  @@index([userId, read, createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model MentalGameSubmission {
  id                 String                       @id @default(cuid())
  userId             String
  userEmail          String
  playerName         String
  playerAge          String
  topic              MentalGameTopic
  message            String
  whereWasThis       String?
  lookAtFocus        String?
  videoPath                  String?
  submittedVideoPosterR2Key  String?
  responsePreference MentalGameResponsePreference
  reviewTrack        CoachingReviewTrack?
  status             MentalGameSubmissionStatus   @default(PENDING)
  responseText       String?
  responseVideoUrl   String?
  responseVideoPosterR2Key   String?
  recommendedDrills  String[]                     @default([])
  memberVimeoLink    String?
  respondedAt        DateTime?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  user               User                         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SwingAnalysisSubmission {
  id                 String                       @id @default(cuid())
  userId             String
  userEmail          String
  playerName         String
  pitchType          String
  handedness         String
  whereWasThis       String?
  lookAtFocus        String?
  videoCategory      String?
  notes              String
  submittedVideo             String
  submittedVideoPosterR2Key  String?
  responsePreference MentalGameResponsePreference
  status             MentalGameSubmissionStatus   @default(PENDING)
  responseText       String?
  responseVideoUrl   String?
  responseVideoPosterR2Key   String?
  recommendedDrills            String[]                     @default([])
  memberVimeoLink              String?
  reviewTrack                  CoachingReviewTrack?
  coachFocusPreset             String?
  coachFocusEndsAt             DateTime?
  reportStrengths              String[]                     @default([])
  reportAreasToImprove         String[]                     @default([])
  reportRecommendedDrillLines  String[]                     @default([])
  reportNoteFromCoach          String?
  reportLibraryDrillIds        String[]                     @default([])
  reportRecommendedFixItSlug   String?
  evaluationPdfR2Key           String?
  respondedAt                  DateTime?
  createdAt                    DateTime                     @default(now())
  updatedAt                    DateTime                     @updatedAt
  user                         User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  reportEditLogs               SwingAnalysisReportEditLog[]

  @@index([userId])
  @@index([reviewTrack, status, createdAt])
  @@index([status, respondedAt])
}

model SwingAnalysisReportEditLog {
  id                 String                  @id @default(cuid())
  submissionId       String
  editedByAdminEmail String
  createdAt          DateTime                @default(now())
  submission         SwingAnalysisSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

model GoalCheckin {
  id                Int        @id @default(autoincrement())
  userId            String
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  monthlyFocus      String
  lastMonthReview   String
  focusArea         String
  additionalNotes   String?
  coachResponse     String?
  status            String     @default("pending")
  createdAt         DateTime   @default(now())
  respondedAt       DateTime?
  goals             GoalItem[]

  @@index([userId])
  @@index([userId, createdAt])
}

model GoalItem {
  id           Int         @id @default(autoincrement())
  checkinId    Int
  checkin      GoalCheckin @relation(fields: [checkinId], references: [id], onDelete: Cascade)
  category     String
  description  String
  targetValue  String?
  completed    Boolean     @default(false)
  completedAt  DateTime?
  createdAt    DateTime    @default(now())

  @@index([checkinId])
}

model PlaybookProgress {
  id              Int               @id @default(autoincrement())
  userId          String            @unique
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  overallComplete Boolean           @default(false)
  completedAt     DateTime?
  coachNotes      String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  chapters        PlaybookChapter[]
}

model PlaybookChapter {
  id            Int                  @id @default(autoincrement())
  progressId    Int
  progress      PlaybookProgress     @relation(fields: [progressId], references: [id], onDelete: Cascade)
  chapterNumber Int
  chapterTitle  String
  completed     Boolean              @default(false)
  completedAt   DateTime?
  reflections   PlaybookReflection[]

  @@unique([progressId, chapterNumber])
  @@index([progressId])
}

model PlaybookReflection {
  id              Int             @id @default(autoincrement())
  chapterId       Int
  chapter         PlaybookChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  questionNumber  Int
  questionText    String
  answer          String?
  sharedWithCoach Boolean         @default(false)
  sharedAt        DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([chapterId, questionNumber])
  @@index([chapterId])
  @@index([sharedWithCoach, sharedAt])
}

model TestTeam {
  id         String           @id @default(cuid())
  name       String
  teamSlug   String           @unique
  season     String           @default("")
  coachName  String           @default("")
  coachEmail String?
  archived   Boolean          @default(false)
  createdAt  DateTime         @default(now())
  roster     TestTeamPlayer[]
  sessions   TestSession[]

  @@index([archived, createdAt(sort: Desc)])
}

model TestStation {
  key        String   @id
  label      String
  sortOrder  Int
  active     Boolean  @default(true)
  metricKeys String[]

  @@index([active, sortOrder])
}

model TestPlayer {
  id                String            @id @default(cuid())
  firstName         String
  lastName          String
  birthYear         Int?
  age               Int?
  positions         String[]          @default([])
  bats              String?
  throws            String?
  parentEmail       String?
  claimCode         String            @unique
  userId            String?
  user              User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  waiverSignatureId String?
  waiverSignature   WaiverSignature?  @relation(fields: [waiverSignatureId], references: [id], onDelete: SetNull)
  createdAt         DateTime          @default(now())
  teams             TestTeamPlayer[]
  results           TestResult[]

  @@index([lastName, firstName])
  @@index([userId])
  @@index([waiverSignatureId])
}

model TestTeamPlayer {
  id       String     @id @default(cuid())
  teamId   String
  team     TestTeam   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  playerId String
  player   TestPlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([teamId, playerId])
  @@index([playerId])
}

model TestMetric {
  key        String       @id
  label      String
  unit       String
  decimals   Int
  betterIs   TestBetterIs
  category   String
  active     Boolean      @default(true)
  sortOrder  Int
  inputType  String       @default("number")
  results    TestResult[]

  @@index([active, sortOrder])
}

model TestSession {
  id      String       @id @default(cuid())
  teamId  String
  team    TestTeam     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  date    DateTime     @db.Date
  label   String
  notes   String?
  results TestResult[]

  @@unique([teamId, date])
  @@index([teamId, date(sort: Desc)])
}

model TestResult {
  id        String      @id @default(cuid())
  sessionId String
  session   TestSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  playerId  String
  player    TestPlayer  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  metricKey String
  metric    TestMetric  @relation(fields: [metricKey], references: [key], onDelete: Restrict)
  attempts  Float[]     @default([])
  best      Float?
  absent    Boolean     @default(false)
  skipped   Boolean     @default(false)
  notes     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([sessionId, playerId, metricKey])
  @@index([playerId, metricKey])
  @@index([sessionId, metricKey])
}

model DrillLibraryCatalog {
  vimeoId        String   @id
  isStarterDrill Boolean  @default(false)
  updatedAt      DateTime @updatedAt
}

model MembershipSubscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  stripeCustomerId     String
  stripeSubscriptionId String             @unique
  stripePriceId        String?
  stripeScheduleId     String?
  level                MembershipLevel
  status               SubscriptionStatus
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean            @default(false)
  pendingLevel         MembershipLevel?
  startedAt            DateTime
  organizationId       String?
  orgJoinedAtSnapshot  DateTime?
  pastDueGraceEndsAt   DateTime?
  accessEndedAt        DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization         Organization?      @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  payments             MembershipSubscriptionPayment[]

  @@index([organizationId])
  @@index([status, level])
}

model MembershipSubscriptionPayment {
  id                       String                  @id @default(cuid())
  stripeInvoiceId          String                  @unique
  membershipSubscriptionId String?
  userId                   String?
  level                    MembershipLevel?
  amountCents              Int
  currency                 String                  @default("usd")
  paidAt                   DateTime
  createdAt                DateTime                @default(now())
  membershipSubscription   MembershipSubscription? @relation(fields: [membershipSubscriptionId], references: [id], onDelete: SetNull)

  @@index([userId, paidAt(sort: Desc)])
  @@index([membershipSubscriptionId])
}

model StripeWebhookEvent {
  stripeEventId String   @id
  type          String
  processedAt   DateTime @default(now())
}

model AllAccessWaitlistEntry {
  id        String   @id @default(cuid())
  name      String
  email     String
  note      String?
  userId    String?
  createdAt DateTime @default(now())

  @@index([email])
  @@index([createdAt(sort: Desc)])
}

model PlatformCoachingSettings {
  id                  String @id @default("default")
  allAccessProgramCap Int    @default(25)
}

