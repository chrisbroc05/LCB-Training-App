generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum MembershipTier {
  FREE
  BASIC
  TWELVE_WEEK
  MEMORABLE
  ELITE
}

enum SubscriptionStatus {
  NONE
  ACTIVE
  CANCEL_AT_PERIOD_END
  CANCELED
}

enum MentalGameTopic {
  SLUMP
  CONFIDENCE
  NERVES
  FEAR_OF_FAILURE
  PRESSURE_SITUATIONS
  LOSING_MOTIVATION
  OTHER
}

enum MentalGameResponsePreference {
  VIDEO_RESPONSE
  WRITTEN_RESPONSE
}

enum MentalGameSubmissionStatus {
  PENDING
  REVIEWING
  COMPLETED
}

enum ProgramEnrollmentStatus {
  ACTIVE
  PAUSED
  COMPLETED
  REFUNDED
}

enum DayLogType {
  GAME
  PRACTICE
}

enum ProgramAgeGroup {
  AGE_8_11
  AGE_12_15
  AGE_16_18
}

enum ProgramSeasonMode {
  IN_SEASON
  OFF_SEASON
}

enum ProgramEmailRecipient {
  player
  parent
  coach
}

enum ProgramEmailType {
  DAILY_ROUTINE
  DAY_BEFORE_START
  SATURDAY_VIDEO_REMINDER
  GONE_QUIET
  PARENT_SATURDAY_VIDEO
  PARENT_GONE_QUIET
  PARENT_WEEKLY_RECAP
  COACH_DAILY_SUMMARY
  COACH_MESSAGE_REPLY
  COACH_VIDEO
}

enum PushNotificationType {
  DAILY_WORK
  DAY_BEFORE_START
  SATURDAY_VIDEO
  GONE_QUIET
  COACH_RESPONSE
  PLAN_UPDATE
  COACH_NEW_SUBMISSION
  COACH_NEW_PROGRAM_PLAYER
  COACH_NIGHTLY_SUMMARY
  COACH_NEW_MESSAGE
  COACH_REPLY
  COACH_REFUND_PROCESSED
  COACH_WAIVER_SIGNED
  COACH_VIDEO
  TEST
}

enum CoachVideoDrillCategory {
  HITTING
  FIELDING
  MINDSET
  OTHER
}

enum WaiverSignupType {
  PRIVATE_LESSONS
  GROUP_LESSONS
  TEAM_TRAINING
  OTHER
}

enum TestBetterIs {
  LOWER
  HIGHER
}

enum MarketingEmailType {
  WELCOME
  FREE_SUBMISSION_REMINDER
  FOLLOWUP_DRILLS_DAY_2
  FOLLOWUP_OTHER_SIX_DAY_4
  FOLLOWUP_SAMPLE_DAY_DAY_7
  FOLLOWUP_KNOWN_FOR_DAY_10
}

enum AccountRole {
  PLAYER
  PARENT
}

model User {
  id                     String                 @id @default(cuid())
  name                   String?
  accountRole            AccountRole            @default(PLAYER)
  accountHolderName      String?
  playerFirstName        String?
  playerLastName         String?
  email                  String                 @unique
  password               String
  signupDate             DateTime               @default(now())
  onboardingEmail1Sent   Boolean                @default(false)
  onboardingEmail2Sent   Boolean                @default(false)
  onboardingEmail3Sent   Boolean                @default(false)
  freeSubmissionUsed     Boolean                @default(false)
  coachingSubmissionsUsedThisMonth Int          @default(0)
  coachingSubmissionPeriod         String?
  eliteRolloverCredits             Int          @default(0)
  assessmentCallBooked             Boolean      @default(false)
  assessmentCallDate               DateTime?
  twelveWeekCallBooked             Boolean      @default(false)
  twelveWeekCallScheduledAt        DateTime?
  membershipTier         MembershipTier         @default(FREE)
  membershipTierBeforeProgram MembershipTier?
  marketingEmailsSuppressed Boolean             @default(false)
  twelveWeekProgramStartedAt DateTime?
  twelveWeekProgramEndsAt    DateTime?
  pendingCheckoutTier    MembershipTier?
  subscriptionStatus     SubscriptionStatus     @default(ACTIVE)
  stripeCustomerId       String?                @unique
  stripeSubscriptionId   String?                @unique
  stripePriceId          String?
  subscriptionCurrentPeriodEnd DateTime?
  subscriptionCancelAtPeriodEnd Boolean         @default(false)
  position               String?
  age                    Int?
  graduationYear         Int?
  currentTeam            String?
  level                  String?
  playerBio              String?
  adminNotes             String?
  notifySubmissionResponse Boolean              @default(true)
  notifyGoalResponse       Boolean              @default(true)
  notifyWeeklyCheckin      Boolean              @default(true)
  notifyAnnouncements      Boolean              @default(true)
  termsVersion           String?
  termsAcceptedAt        DateTime?
  acceptedByName         String?
  acceptedAsParent       Boolean                @default(false)
  playerAge              Int?
  parentConsentName      String?
  parentConsentEmail     String?
  parentConsentConfirmedAt DateTime?
  parentConsentEmailSentAt DateTime?
  parentConsentReminderSentAt DateTime?
  parentConsentManualResendDayKey String?
  parentConsentManualResendCount Int @default(0)
  mediaConsent           Boolean                @default(false)
  mediaConsentUpdatedAt  DateTime?
  trainsInPerson         Boolean                @default(false)
  emergencyContactName   String?
  emergencyContactPhone  String?
  medicalNotes           String?
  inPersonInfoUpdatedAt  DateTime?
  emailVerified          DateTime?
  image                  String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  accounts               Account[]
  sessions               Session[]
  mentalGameSubmissions  MentalGameSubmission[]
  swingAnalysisSubmissions SwingAnalysisSubmission[]
  goalCheckins           GoalCheckin[]
  playbookProgress       PlaybookProgress?
  notifications          Notification[]
  programEnrollment      ProgramEnrollment?
  pushSubscriptions      PushSubscription[]
  pushLogs               PushLog[]
  marketingEmailLogs     MarketingEmailLog[]
  coachAlertSettings     CoachAlertSettings?
  sentMessages           Message[]              @relation("MessageSender")
  waiverSignatures       WaiverSignature[]
  coachVideos            CoachVideo[]
  testPlayers            TestPlayer[]
}

model WaiverSignature {
  id                    String           @id @default(cuid())
  playerFirstName       String
  playerLastName        String
  playerAge             Int
  teamName              String?
  teamSlug              String?
  signupType            WaiverSignupType
  signerFullName        String
  signerEmail           String
  signerPhone           String?
  emergencyContactName  String
  emergencyContactPhone String
  medicalNotes          String?
  mediaConsent          Boolean          @default(false)
  typedSignature        String
  version               String
  signedAt              DateTime         @default(now())
  submissionBatchId     String?
  ip                    String
  userId                String?
  user                  User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  testPlayers           TestPlayer[]

  @@index([signedAt(sort: Desc)])
  @@index([teamSlug])
  @@index([signerEmail])
  @@index([userId])
  @@index([ip, signedAt])
  @@index([submissionBatchId])
}

model MarketingEmailLog {
  id                 String             @id @default(cuid())
  userId             String
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  type               MarketingEmailType
  dedupeKey          String             @unique
  anchorSubmissionId String?
  sentAt             DateTime           @default(now())

  @@index([userId, type])
}

model ProgramEnrollment {
  id                    String                  @id @default(cuid())
  userId                String                  @unique
  user                  User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  status                ProgramEnrollmentStatus @default(ACTIVE)
  refundedAt            DateTime?
  refundAmountCents     Int?
  stripeRefundChargeId  String?                 @unique
  startDate             DateTime?               @db.Date
  ageGroup              ProgramAgeGroup?
  position              String?
  focusAreas            String[]                @default([])
  equipment             String[]                @default([])
  strengthVariant       String?
  seasonMode            ProgramSeasonMode?
  knownFor                   String?
  onboardingCompletedAt      DateTime?
  dailyRoutineEmailsEnabled  Boolean                 @default(true)
  parentName                 String?
  parentEmail                String?
  parentEmailsEnabled        Boolean                 @default(true)
  parentPromptDismissedAt    DateTime?
  createdAt                  DateTime                @default(now())
  updatedAt                  DateTime                @updatedAt
  taskCompletions            TaskCompletion[]
  weekFocusOverrides         WeekFocusOverride[]
  customTasks                CustomTask[]
  dayLogs                    DayLog[]
  emailLogs                  EmailLog[]
  conversation               Conversation?
  coachVideos                CoachVideo[]
}

model CoachVideo {
  id               String                   @id @default(cuid())
  userId           String
  user             User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollmentId     String?
  enrollment       ProgramEnrollment?       @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  title            String
  note             String?
  videoKey         String
  videoContentType String
  videoSizeBytes   Int
  drillCategory    CoachVideoDrillCategory?
  notifyPending    Boolean                  @default(false)
  createdAt        DateTime                 @default(now())
  viewedAt         DateTime?

  @@index([userId, createdAt(sort: Desc)])
  @@index([enrollmentId])
  @@index([notifyPending])
}

model EmailLog {
  id           String                @id @default(cuid())
  enrollmentId String?
  enrollment   ProgramEnrollment?    @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  recipient    ProgramEmailRecipient
  type         ProgramEmailType
  dateKey      String
  dedupeKey    String                @unique
  sentAt       DateTime              @default(now())

  @@unique([enrollmentId, recipient, type, dateKey])
  @@index([type, dateKey])
}

model PushSubscription {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint      String
  p256dh        String
  auth          String
  userAgent     String?
  createdAt     DateTime  @default(now())
  lastSuccessAt DateTime?
  failureCount  Int       @default(0)

  @@unique([userId, endpoint])
  @@index([userId])
  @@index([endpoint])
}

model CoachAlertSettings {
  userId                     String   @id
  user                       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  newVideosEnabled           Boolean  @default(true)
  newProgramPlayersEnabled     Boolean  @default(true)
  newMessagesEnabled         Boolean  @default(true)
  nightlySummaryPushEnabled    Boolean  @default(true)
  emailNightlySummaryEnabled   Boolean  @default(true)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}

model Conversation {
  id                         String            @id @default(cuid())
  enrollmentId               String            @unique
  enrollment                 ProgramEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  createdAt                  DateTime          @default(now())
  lastMessageAt              DateTime          @default(now())
  coachUnreadCount           Int               @default(0)
  playerUnreadCount          Int               @default(0)
  playerReplyNotifyPending   Boolean           @default(false)
  playerReplyNotifyMessageId String?
  messages                   Message[]

  @@index([lastMessageAt])
  @@index([coachUnreadCount])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUserId   String
  sender         User         @relation("MessageSender", fields: [senderUserId], references: [id], onDelete: Cascade)
  fromCoach      Boolean
  body           String       @db.VarChar(1000)
  createdAt      DateTime     @default(now())
  readAt         DateTime?

  @@index([conversationId, createdAt])
  @@index([senderUserId, createdAt])
}

model PushLog {
  id        String               @id @default(cuid())
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      PushNotificationType
  dedupeKey String               @unique
  sentAt    DateTime             @default(now())
  success   Boolean
  error     String?

  @@index([userId, type])
}

model CoachCue {
  id                 String              @id @default(cuid())
  label              String
  drillIds           String[]            @default([])
  isDefault          Boolean             @default(false)
  defaultWeek        Int?
  archived           Boolean             @default(false)
  createdAt          DateTime            @default(now())
  weekFocusOverrides WeekFocusOverride[]
}

model WeekFocusOverride {
  id           String            @id @default(cuid())
  enrollmentId String
  enrollment   ProgramEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  weekNumber   Int
  cueId        String
  cue          CoachCue          @relation(fields: [cueId], references: [id], onDelete: Restrict)
  note         String            @db.VarChar(300)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([enrollmentId, weekNumber])
  @@index([enrollmentId])
}

model CustomTask {
  id              String            @id @default(cuid())
  enrollmentId    String
  enrollment      ProgramEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  programDay      Int
  title           String
  target          String
  details         String?
  drillIds        String[]          @default([])
  replacesTaskKey String?
  createdAt       DateTime          @default(now())

  @@index([enrollmentId, programDay])
}

model DayLog {
  id              String            @id @default(cuid())
  enrollmentId    String
  enrollment      ProgramEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  programDay      Int
  type            DayLogType
  note            String            @db.VarChar(500)
  createdAt       DateTime          @default(now())
  gameStats       GameStats?
  taskCompletions TaskCompletion[]

  @@index([enrollmentId, programDay])
}

model GameStats {
  id          String  @id @default(cuid())
  dayLogId    String  @unique
  dayLog      DayLog  @relation(fields: [dayLogId], references: [id], onDelete: Cascade)
  opponent    String? @db.VarChar(60)
  atBats      Int     @default(0)
  hits        Int     @default(0)
  doubles     Int     @default(0)
  triples     Int     @default(0)
  homeRuns    Int     @default(0)
  walks       Int     @default(0)
  hitByPitch  Int     @default(0)
  runs        Int     @default(0)
  rbis        Int     @default(0)
  strikeouts  Int     @default(0)
  stolenBases Int     @default(0)
  errors      Int     @default(0)
}

model TaskCompletion {
  id             String            @id @default(cuid())
  enrollmentId   String
  enrollment     ProgramEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  programDay     Int
  taskKey        String
  taskType       String
  note           String
  completedAt    DateTime          @default(now())
  sourceDayLogId String?
  sourceDayLog   DayLog?           @relation(fields: [sourceDayLogId], references: [id], onDelete: SetNull)

  @@unique([enrollmentId, programDay, taskKey])
  @@index([enrollmentId, programDay])
  @@index([sourceDayLogId])
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String?
  type      String
  read      Boolean  @default(false)
  linkUrl   String?
  createdAt DateTime @default(now())

  @@index([userId, read, createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model MentalGameSubmission {
  id                 String                       @id @default(cuid())
  userId             String
  userEmail          String
  playerName         String
  playerAge          String
  topic              MentalGameTopic
  message            String
  whereWasThis       String?
  lookAtFocus        String?
  videoPath          String?
  responsePreference MentalGameResponsePreference
  status             MentalGameSubmissionStatus   @default(PENDING)
  responseText       String?
  responseVideoUrl   String?
  recommendedDrills  String[]                     @default([])
  memberVimeoLink    String?
  respondedAt        DateTime?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  user               User                         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SwingAnalysisSubmission {
  id                 String                       @id @default(cuid())
  userId             String
  userEmail          String
  playerName         String
  pitchType          String
  handedness         String
  whereWasThis       String?
  lookAtFocus        String?
  videoCategory      String?
  notes              String
  submittedVideo     String
  responsePreference MentalGameResponsePreference
  status             MentalGameSubmissionStatus   @default(PENDING)
  responseText       String?
  responseVideoUrl   String?
  recommendedDrills  String[]                     @default([])
  memberVimeoLink    String?
  respondedAt        DateTime?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  user               User                         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model GoalCheckin {
  id                Int        @id @default(autoincrement())
  userId            String
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  monthlyFocus      String
  lastMonthReview   String
  focusArea         String
  additionalNotes   String?
  coachResponse     String?
  status            String     @default("pending")
  createdAt         DateTime   @default(now())
  respondedAt       DateTime?
  goals             GoalItem[]

  @@index([userId])
  @@index([userId, createdAt])
}

model GoalItem {
  id           Int         @id @default(autoincrement())
  checkinId    Int
  checkin      GoalCheckin @relation(fields: [checkinId], references: [id], onDelete: Cascade)
  category     String
  description  String
  targetValue  String?
  completed    Boolean     @default(false)
  completedAt  DateTime?
  createdAt    DateTime    @default(now())

  @@index([checkinId])
}

model PlaybookProgress {
  id              Int               @id @default(autoincrement())
  userId          String            @unique
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  overallComplete Boolean           @default(false)
  completedAt     DateTime?
  coachNotes      String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  chapters        PlaybookChapter[]
}

model PlaybookChapter {
  id            Int                  @id @default(autoincrement())
  progressId    Int
  progress      PlaybookProgress     @relation(fields: [progressId], references: [id], onDelete: Cascade)
  chapterNumber Int
  chapterTitle  String
  completed     Boolean              @default(false)
  completedAt   DateTime?
  reflections   PlaybookReflection[]

  @@unique([progressId, chapterNumber])
  @@index([progressId])
}

model PlaybookReflection {
  id              Int             @id @default(autoincrement())
  chapterId       Int
  chapter         PlaybookChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  questionNumber  Int
  questionText    String
  answer          String?
  sharedWithCoach Boolean         @default(false)
  sharedAt        DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([chapterId, questionNumber])
  @@index([chapterId])
  @@index([sharedWithCoach, sharedAt])
}

model TestTeam {
  id         String           @id @default(cuid())
  name       String
  teamSlug   String           @unique
  season     String           @default("")
  coachName  String           @default("")
  coachEmail String?
  archived   Boolean          @default(false)
  createdAt  DateTime         @default(now())
  roster     TestTeamPlayer[]
  sessions   TestSession[]

  @@index([archived, createdAt(sort: Desc)])
}

model TestStation {
  key        String   @id
  label      String
  sortOrder  Int
  active     Boolean  @default(true)
  metricKeys String[]

  @@index([active, sortOrder])
}

model TestPlayer {
  id                String            @id @default(cuid())
  firstName         String
  lastName          String
  birthYear         Int?
  age               Int?
  positions         String[]          @default([])
  bats              String?
  throws            String?
  parentEmail       String?
  claimCode         String            @unique
  userId            String?
  user              User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  waiverSignatureId String?
  waiverSignature   WaiverSignature?  @relation(fields: [waiverSignatureId], references: [id], onDelete: SetNull)
  createdAt         DateTime          @default(now())
  teams             TestTeamPlayer[]
  results           TestResult[]

  @@index([lastName, firstName])
  @@index([userId])
  @@index([waiverSignatureId])
}

model TestTeamPlayer {
  id       String     @id @default(cuid())
  teamId   String
  team     TestTeam   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  playerId String
  player   TestPlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([teamId, playerId])
  @@index([playerId])
}

model TestMetric {
  key        String       @id
  label      String
  unit       String
  decimals   Int
  betterIs   TestBetterIs
  category   String
  active     Boolean      @default(true)
  sortOrder  Int
  inputType  String       @default("number")
  results    TestResult[]

  @@index([active, sortOrder])
}

model TestSession {
  id      String       @id @default(cuid())
  teamId  String
  team    TestTeam     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  date    DateTime     @db.Date
  label   String
  notes   String?
  results TestResult[]

  @@unique([teamId, date])
  @@index([teamId, date(sort: Desc)])
}

model TestResult {
  id        String      @id @default(cuid())
  sessionId String
  session   TestSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  playerId  String
  player    TestPlayer  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  metricKey String
  metric    TestMetric  @relation(fields: [metricKey], references: [key], onDelete: Restrict)
  attempts  Float[]     @default([])
  best      Float?
  absent    Boolean     @default(false)
  skipped   Boolean     @default(false)
  notes     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([sessionId, playerId, metricKey])
  @@index([playerId, metricKey])
  @@index([sessionId, metricKey])
}

