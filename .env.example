# Local dev: copy to .env and fill in (never commit .env).

# Neon dev (pooled for the app; direct for migrations)
DATABASE_URL="postgresql://USER:PASS@HOST/neondb?sslmode=require"
DATABASE_DIRECT_URL="postgresql://USER:PASS@HOST-DIRECT/neondb?sslmode=require"
TEST_DATABASE_URL="postgresql://USER:PASS@HOST/neondb?sslmode=require"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-long-random-dev-secret"
SUBMISSION_VIDEO_LINK_SECRET="generate-a-long-random-dev-secret"

ADMIN_EMAIL="coach@example.com"
NOTIFICATION_EMAIL="dev-outbox@localhost"
EMAIL_PASSWORD="not-used-in-dev-outbox-mode"

STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_from_stripe_listen_cli"

# Phase 2A monthly membership (test mode price IDs)
STRIPE_PRICE_CORE_MONTHLY="price_..."
STRIPE_PRICE_PLUS_MONTHLY="price_..."
STRIPE_PRICE_ALL_ACCESS_MONTHLY="price_..."

ONBOARDING_CRON_SECRET="dev-cron-secret"
CRON_SECRET="dev-cron-secret"

VAPID_PUBLIC_KEY="dev-vapid-public"
VAPID_PRIVATE_KEY="dev-vapid-private"
VAPID_SUBJECT="mailto:dev@localhost"
NEXT_PUBLIC_VAPID_PUBLIC_KEY="dev-vapid-public"

VIMEO_UPLOAD_ENABLED="false"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_FOLDER="lcb-training/dev"
CLOUDINARY_ADMIN_RESPONSE_UPLOAD_ENABLED="false"

CLOUDFLARE_R2_ENDPOINT="https://ACCOUNT_ID.r2.cloudflarestorage.com"
CLOUDFLARE_R2_ACCESS_KEY_ID=""
CLOUDFLARE_R2_SECRET_ACCESS_KEY=""
CLOUDFLARE_R2_BUCKET_NAME="lcb-training-app-dev"

# Leave empty locally (do not use production deploy hooks)
RENDER_DEPLOY_HOOK=""

NEXT_PUBLIC_GA_ID=""
